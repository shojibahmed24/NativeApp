{
  "expo": {
    "name": "UniCom",
    "slug": "unicom-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo-icon-transparent.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/logo-full-transparent.png",
      "resizeMode": "contain",
      "backgroundColor": "#f8fafc"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "voip",
          "audio"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo-icon-transparent.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundledJavaScript": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ]
    ],
    "scheme": "native-app",
    "main": "expo-router/entry"
  }
}