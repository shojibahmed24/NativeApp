{
  "expo": {
    "name": "UniCom",
    "slug": "unicom-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo-icon-transparent.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/logo-full-transparent.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "voip",
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.unicom.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo-icon-transparent.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_CONTACTS",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "bundledJavaScript": true
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-audio",
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "expo-secure-store",
      "expo-status-bar",
      "expo-asset"
    ],
    "scheme": "native-app",
    "main": "expo-router/entry",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8c1f7d28-c95f-4aab-b12c-8d43d61d4868"
      }
    },
    "owner": "shojibahmed"
  }
}